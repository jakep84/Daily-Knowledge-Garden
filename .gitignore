
# ======================================
# Daily Knowledge Garden .gitignore
# ======================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
*.env

# Environment variables and secrets
.env
.env.*
*.secret
*.credentials
credentials.json
secrets.json

# Email output
/out/
*.eml
/email.html
/email_subject.txt

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Temporary files
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# IDE settings
.vscode/
.idea/
*.iml

# Python caches
.cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ======================================
# DAILY KNOWLEDGE GARDEN OUTPUT
# ======================================

# IMPORTANT:
# Daily reports, JSON data, website HTML,
# charts and images MUST be committed.

# Keep daily raw snapshots and reports
!/data/
!/data/**/

# Ignore per-run snapshots to avoid
# unnecessary repository growth
/data/**/runs/

# Keep generated GitHub Pages website
!/docs/
!/docs/**/

# Preserve GitHub Pages configuration
!/docs/.nojekyll

# GitHub Actions caches
/.github/workflows/__pycache__/
/.github/actions/__pycache__/
